# ---------------------------------------------------------------------------
# PrisonConnect warden dashboard — copy to `warden-dashboard/.env`
#
#   cp warden-dashboard/.env.example warden-dashboard/.env
#
# Vite only reads .env files present at build time.
# ---------------------------------------------------------------------------

# Backend API gateway the browser talks to (no trailing slash).
VITE_API_GATEWAY_URL=http://127.0.0.1:3000

# Socket.IO signaling server — live call status / force-end events.
VITE_SIGNALING_URL=http://127.0.0.1:3002

# Note: the dev server also proxies `/api` (see vite.config.ts). That proxy is
# for local development only and does not affect the production build.
