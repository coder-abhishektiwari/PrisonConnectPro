<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain> <!-- Android Emulator Loopback -->
    </domain-config>
    <domain-config cleartextTrafficPermitted="false">
        <!-- Real deployments are HTTPS (Render). Cleartext stays permitted
             only for the base-config dev hosts above. -->
        <domain includeSubdomains="true">onrender.com</domain>
    </domain-config>
</network-security-config>
