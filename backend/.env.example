# ---------------------------------------------------------------------------
# PrisonConnect backend — copy to `backend/.env`
#
#   cp backend/.env.example backend/.env
#
# NEVER commit the real `.env` (it is gitignored). This example file carries
# no secrets — only variable names and placeholder values.
# ---------------------------------------------------------------------------

# ---- Required: the server refuses to start without these two -------------
# Long random string used to sign/verify JWTs. Same value must be used by
# signaling-server (and it must match tokens already issued if you rotate it).
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL connection string. On every boot the server runs migrations
# (backend/db-schema/*.sql); a fresh database starts empty — create the first
# account with POST /auth/register.
# Cloud hosts (Render/Supabase) are auto-detected and get SSL enabled;
# set DATABASE_SSL=true/false to force it either way.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/prisonconnect

# ---- Server ---------------------------------------------------------------
PORT=3000
CORS_ORIGIN=*
# Access tokens are deliberately short: stolen-JWT window is minutes, not
# hours. Clients refresh automatically (dashboards + Android kiosk interceptor).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
JSON_BODY_LIMIT=10mb
# NODE_ENV=production

# ---- Call / WebRTC --------------------------------------------------------
# Socket.IO signaling hub the kiosk + family browser both connect to.
SIGNALING_URL=http://127.0.0.1:3002
# Public base URL of the family portal — call links in SMS are built from this.
FAMILY_WEB_URL=http://127.0.0.1:5173
# Handed to clients inside every create-call response so the kiosk never needs
# an APK rebuild when the public signaling URL changes. Set this on Render.
# SIGNALING_PUBLIC_URL=
# Required for call control (mute/terminate) — the backend calls the signaling
# server's control API with this as X-API-Key. Any long random string works;
# the signaling server does not validate it.
MEDIA_API_KEY=
# Room participant cap lives on the signaling-server service, not here.

# ---- SMS / OTP ------------------------------------------------------------
# `log` writes to console + backend/logs/sms.jsonl and costs nothing.
# Switch to `fast2sms` only after the Fast2SMS keys below are filled in.
SMS_PROVIDER=log
# Domain used by the WebOTP autofill API (must match the family-web origin).
SMS_OTP_DOMAIN=127.0.0.1
SMS_OTP_EXPIRY_MINUTES=5
# FAST2SMS_API_KEY=
# Shared DLT header, used when a kind-specific one below is unset.
# FAST2SMS_SENDER_ID=
# Separate headers per SMS kind (DLT registers sender id + template together).
# Leave blank to fall back to FAST2SMS_SENDER_ID above.
# FAST2SMS_OTP_SENDER_ID=
# FAST2SMS_LINK_SENDER_ID=
# Scheduled-call SMS inherits the link header unless this one is set.
# FAST2SMS_SCHEDULED_SENDER_ID=
# FAST2SMS_ENTITY_ID=
# FAST2SMS_OTP_TEMPLATE_ID=
# FAST2SMS_LINK_TEMPLATE_ID=
# FAST2SMS_SCHEDULED_TEMPLATE_ID=

# ---- Kiosk ----------------------------------------------------------------
# NOTE: the kiosk's auto-logout window is a build-time constant, not a backend
# env var — set AUTO_LOGOUT_TIMEOUT_MS in android-kiosk/local.properties.

# ---- Optional / advanced --------------------------------------------------
# Kiosk device token validity.
# DEVICE_TOKEN_TTL=365d
# REFRESH_TOKEN_TTL_DAYS=
# Credential the audit suite logs in with (node audit-tests.mjs). Never commit
# the real value — it belongs in .env, which is gitignored.
# AUDIT_WARDEN_PASSWORD=
