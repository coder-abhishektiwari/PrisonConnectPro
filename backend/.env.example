# ---------------------------------------------------------------------------
# PrisonConnect backend — copy to `backend/.env`
#
#   cp backend/.env.example backend/.env
#
# NEVER commit the real `.env` (it is gitignored). This example file carries
# no secrets — only variable names and placeholder values.
# ---------------------------------------------------------------------------

# ---- Required: the server refuses to start without these two -------------
# Long random string used to sign/verify JWTs. Same value must be used by
# signaling-server (and it must match tokens already issued if you rotate it).
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL connection string. If the database is EMPTY the server runs
# migrations (backend/db-schema/*.sql) and seeds itself on first boot.
# Cloud hosts (Render/Supabase) are auto-detected and get SSL enabled;
# set DATABASE_SSL=true/false to force it either way.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/prisonconnect

# ---- Server ---------------------------------------------------------------
PORT=3000
CORS_ORIGIN=*
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=7d
JSON_BODY_LIMIT=10mb
# NODE_ENV=production

# ---- Call / WebRTC --------------------------------------------------------
# Socket.IO signaling hub the kiosk + family browser both connect to.
SIGNALING_URL=http://127.0.0.1:3002
# Public base URL of the family portal — call links in SMS are built from this.
FAMILY_WEB_URL=http://127.0.0.1:5173
ROOM_MAX_PARTICIPANTS=2

# ---- SMS / OTP ------------------------------------------------------------
# `log` writes to console + backend/logs/sms.jsonl and costs nothing.
# Switch to `fast2sms` only after the Fast2SMS keys below are filled in.
SMS_PROVIDER=log
# Domain used by the WebOTP autofill API (must match the family-web origin).
SMS_OTP_DOMAIN=127.0.0.1
SMS_OTP_EXPIRY_MINUTES=5
# FAST2SMS_API_KEY=
# FAST2SMS_SENDER_ID=
# FAST2SMS_ENTITY_ID=
# FAST2SMS_OTP_TEMPLATE_ID=
# FAST2SMS_LINK_TEMPLATE_ID=
# FAST2SMS_SCHEDULED_TEMPLATE_ID=

# ---- Face / liveness thresholds -------------------------------------------
FACE_MATCH_THRESHOLD=0.5
FACE_LIVENESS_THRESHOLD=0.5

# ---- Kiosk ---------------------------------------------------------------
# Inactivity window before the kiosk silently logs out (milliseconds).
AUTO_LOGOUT_TIMEOUT_MS=120000

# ---- Optional / advanced --------------------------------------------------
# External jail trust-account API (the kiosk wallet screen falls back to the
# internal ledger when unset).
# JAIL_ACCOUNT_API_URL=
# JAIL_ACCOUNT_TIMEOUT_MS=4000
# SIGNALING_PUBLIC_URL=
# MEDIA_API_KEY=
# REFRESH_TOKEN_TTL_DAYS=

# DESTRUCTIVE: wipe and re-seed every table from backend/legacy-db on startup.
# Only for a database you are happy to throw away.
# FORCE_SEED=true

# Override where seed reads its JSON from (defaults to backend/legacy-db).
# SEED_SRC_DIR=
