# ---------------------------------------------------------------------------
# PrisonConnect signaling server — copy to `signaling-server/.env`
#
#   cp signaling-server/.env.example signaling-server/.env
# ---------------------------------------------------------------------------

# Required: the server refuses to start without it. MUST be the SAME value as
# JWT_SECRET in backend/.env — sockets authenticate with backend-issued JWTs.
JWT_SECRET=change-me-to-a-long-random-string

# Socket.IO / HTTP port. Must match SIGNALING_URL in backend/.env and
# VITE_SIGNALING_URL in the two web clients.
PORT=3002

CORS_ORIGIN=*

# How long a room tolerates a dropped socket before removing the peer.
DISCONNECT_GRACE_MS=15000

# Participants allowed per room (one inmate + one family member = 2).
ROOM_MAX_PARTICIPANTS=2

# Optional TURN relays as a JSON array. Without it the server runs STUN-only
# (direct P2P), which fails behind symmetric NATs / strict corporate firewalls.
# TURN_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
