# Root .gitignore for PrisonConnect

# OS Metadata
.DS_Store
Thumbs.db
Desktop.ini

# IDE & Editor Files
.idea/
.vscode/
*.swp
*.swo
*.iml

# Node / Web Dependencies & Builds
node_modules/
dist/
build/
.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Android Artifacts & Local Settings
.gradle/
local.properties
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.keystore

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.crt
.env.example

# External internet exposure launcher state (generated secrets + runtime tuning)
external/
start-external.tmp.json

# Runtime SMS/OTP audit logs (may contain phone numbers)
backend/logs/
