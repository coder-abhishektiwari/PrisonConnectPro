# ---------------------------------------------------------------------------
# PrisonConnect family portal — copy to `family-web/.env`
#
#   cp family-web/.env.example family-web/.env
#
# Both VITE_ variables are REQUIRED: the build fails fast without them
# (see src/config/env.ts). Vite only reads .env files that are present at
# build time, so set these before running `npm run build`.
# ---------------------------------------------------------------------------

# Backend API gateway the browser talks to (no trailing slash).
VITE_API_GATEWAY_URL=http://127.0.0.1:3000

# Socket.IO signaling server used for WebRTC offer/answer relay.
VITE_SIGNALING_URL=http://127.0.0.1:3002

# Optional JSON array of ICE servers, used instead of the built-in STUN list.
# Provide TURN credentials here for networks that block UDP.
# VITE_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
