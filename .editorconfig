# EditorConfig for PrisonConnect
# http://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4

[*.{java,groovy}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
