    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.3",
    "mediasoup": "^3.24.2",
    "mediasoup-client": "^3.21.0",
    "pg": "^8.23.0",
